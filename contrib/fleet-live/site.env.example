# Branding for your fleet board. Copy to site.env (gitignored) and edit.
# Leave any of these unset and that piece is simply omitted from the page —
# an unconfigured board renders as a plain "fleet" with no domain on it.

# Host shown in the wordmark, page title, and footer, e.g. ani.computer
export FLEET_SITE="example.com"

# Where the footer's site link points
export FLEET_SITE_URL="https://example.com"

# Free-text footer note, e.g. where the private/internal dashboard lives
export FLEET_FOOTER_NOTE="private ops on health.example.com"

# Where live.json and index.html are written (default: /var/www/fleet)
# export FLEET_OUT="/var/www/fleet"
