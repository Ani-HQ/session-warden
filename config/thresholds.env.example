# session-warden v1 — configuration
# Copy to thresholds.env and fill in your values

# Rotation triggers (whichever hits first)
WARDEN_MAX_TOKENS=${WARDEN_MAX_TOKENS:-800000}
WARDEN_MAX_TURNS=${WARDEN_MAX_TURNS:-200}
WARDEN_MAX_BYTES=${WARDEN_MAX_BYTES:-1572864}          # 1.5MB
WARDEN_MAX_COMPACTIONS=${WARDEN_MAX_COMPACTIONS:-5}

# Cooldown: skip re-rotating the same session within this window
WARDEN_COOLDOWN_SECONDS=${WARDEN_COOLDOWN_SECONDS:-600}

# Gateway restart cooldown (seconds between restarts)
WARDEN_GATEWAY_RESTART_COOLDOWN_SECONDS=${WARDEN_GATEWAY_RESTART_COOLDOWN_SECONDS:-60}

# Summarization model (lighter = faster rotation recovery)
WARDEN_SUMMARY_MODEL=${WARDEN_SUMMARY_MODEL:-claude-haiku-4-5-20251001}

# Memory compaction threshold (bytes)
WARDEN_MEMORY_MAX_BYTES=${WARDEN_MEMORY_MAX_BYTES:-16384}

# Paths (use ?= pattern so script-computed values aren't clobbered)
WARDEN_OPENCLAW_HOME=${WARDEN_OPENCLAW_HOME:-$HOME/.openclaw}
WARDEN_CLAUDE_PROJECTS=${WARDEN_CLAUDE_PROJECTS:-$HOME/.claude/projects}
WARDEN_SNAPSHOTTER=                # optional: path to snapshotter script
WARDEN_HOME=${WARDEN_HOME:-$HOME/session-warden}

# Telegram alerts (leave blank to disable)
WARDEN_TELEGRAM_BOT_TOKEN=
WARDEN_TELEGRAM_CHAT_ID=

# Logging
WARDEN_LOG_FILE=${WARDEN_LOG_FILE:-$HOME/session-warden/state/scan.log}
WARDEN_DRY_RUN=${WARDEN_DRY_RUN:-0}
