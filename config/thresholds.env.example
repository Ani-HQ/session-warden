# session-warden configuration
# Copy to thresholds.env and edit. All WARDEN_* vars can also be set via environment.

# ─── PATH for cron context ────────────────────────────────
# Cron has a minimal PATH. Add directories where your binaries live.
# Adjust these paths to match your system.
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# D-Bus session bus (required for `systemctl --user` commands from cron)
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

# ─── Rotation triggers ────────────────────────────────────
# Whichever threshold is hit first triggers a rotation.
WARDEN_MAX_TOKENS=${WARDEN_MAX_TOKENS:-2000000}
WARDEN_MAX_TURNS=${WARDEN_MAX_TURNS:-500}
WARDEN_MAX_BYTES=${WARDEN_MAX_BYTES:-4194304}          # 4 MB
WARDEN_MAX_COMPACTIONS=${WARDEN_MAX_COMPACTIONS:-10}

# ─── Timing ───────────────────────────────────────────────
# Cooldown: skip re-rotating the same session within this window
WARDEN_COOLDOWN_SECONDS=${WARDEN_COOLDOWN_SECONDS:-600}

# Max consecutive failures before backing off (prevents crash loop spam)
WARDEN_MAX_CONSECUTIVE_FAILURES=${WARDEN_MAX_CONSECUTIVE_FAILURES:-3}

# Minimum seconds between gateway restarts
WARDEN_GATEWAY_RESTART_COOLDOWN_SECONDS=${WARDEN_GATEWAY_RESTART_COOLDOWN_SECONDS:-300}

# Seconds of inactivity before a JSONL is considered stale (for mid-turn protection)
WARDEN_ACTIVE_THRESHOLD_SECS=${WARDEN_ACTIVE_THRESHOLD_SECS:-60}

# ─── Summarization ────────────────────────────────────────
# Model used for post-rotation summarization. Haiku is fast and cheap.
WARDEN_SUMMARY_MODEL=${WARDEN_SUMMARY_MODEL:-claude-haiku-4-5-20251001}

# Memory file compaction threshold (bytes). Files larger than this get compacted.
WARDEN_MEMORY_MAX_BYTES=${WARDEN_MEMORY_MAX_BYTES:-16384}

# ─── Snapshot ─────────────────────────────────────────────
# Capture standalone (non-OpenClaw) Claude Code sessions into GBrain.
# Runs via cron/timer; OpenClaw sessions are excluded (handled by context-sync).
WARDEN_SNAPSHOT_WINDOW_MINUTES=${WARDEN_SNAPSHOT_WINDOW_MINUTES:-120}     # lookback window for active sessions
WARDEN_SNAPSHOT_MIN_TURNS=${WARDEN_SNAPSHOT_MIN_TURNS:-4}                 # min new turns since last snapshot to re-summarize
WARDEN_SNAPSHOT_MAX_TURNS=${WARDEN_SNAPSHOT_MAX_TURNS:-40}                # approx cap on transcript size fed to summarizer
WARDEN_SNAPSHOT_INTERVAL_MINUTES=${WARDEN_SNAPSHOT_INTERVAL_MINUTES:-30}  # cron/timer frequency

# ─── Agent scope ──────────────────────────────────────────
# Space-separated list of agent names to scan. Empty = scan all agents.
WARDEN_SCAN_AGENTS=${WARDEN_SCAN_AGENTS:-""}

# ─── Paths ────────────────────────────────────────────────
# These are auto-detected by install.sh. Override if your layout differs.
WARDEN_OPENCLAW_HOME=${WARDEN_OPENCLAW_HOME:-$HOME/.openclaw}
WARDEN_CLAUDE_PROJECTS=${WARDEN_CLAUDE_PROJECTS:-$HOME/.claude/projects}
WARDEN_HOME=${WARDEN_HOME:-$HOME/session-warden}

# ─── Alerts (optional) ───────────────────────────────────
# Telegram bot token and chat ID for rotation alerts. Leave blank to disable.
WARDEN_TELEGRAM_BOT_TOKEN=
WARDEN_TELEGRAM_CHAT_ID=

# ─── Archive cleanup ─────────────────────────────────────
# Delete archived JSONL files older than this many days (used by cleanup-archives.sh)
WARDEN_ARCHIVE_RETENTION_DAYS=${WARDEN_ARCHIVE_RETENTION_DAYS:-7}

# ─── Logging ──────────────────────────────────────────────
WARDEN_LOG_FILE=${WARDEN_LOG_FILE:-$HOME/session-warden/state/scan.log}
WARDEN_DRY_RUN=${WARDEN_DRY_RUN:-0}
