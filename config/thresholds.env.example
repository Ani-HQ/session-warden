# session-warden configuration
# Copy to thresholds.env and edit. All WARDEN_* vars can also be set via environment.

# ─── PATH for cron context ────────────────────────────────
# Cron has a minimal PATH. Add directories where your binaries live.
# Adjust these paths to match your system.
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# D-Bus session bus (required for `systemctl --user` commands from cron)
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

# ─── Rotation triggers ────────────────────────────────────
# Whichever threshold is hit first triggers a rotation.
WARDEN_MAX_TOKENS=${WARDEN_MAX_TOKENS:-2000000}
WARDEN_MAX_TURNS=${WARDEN_MAX_TURNS:-500}
WARDEN_MAX_COMPACTIONS=${WARDEN_MAX_COMPACTIONS:-10}

# ─── Burn firewall ────────────────────────────────────────
# Protects your Claude subscription window: samples per-channel token usage
# into state/burn/<agent>.jsonl every scan. Reporting and BURN/LOOP/BUDGET
# detection build on this ledger. Set to 0 to disable sampling entirely.
WARDEN_BURN_ENABLED=${WARDEN_BURN_ENABLED:-1}
# Ledger retention in days (pruned by cleanup-archives.sh)
WARDEN_BURN_RETENTION_DAYS=${WARDEN_BURN_RETENTION_DAYS:-8}
# Subscription window length (5h Claude window) — reporting + budget checks
WARDEN_BURN_WINDOW_SECONDS=${WARDEN_BURN_WINDOW_SECONDS:-18000}
# Per-agent token budget per window. 0 = observe-only (no budget alerts).
WARDEN_BURN_WINDOW_BUDGET=${WARDEN_BURN_WINDOW_BUDGET:-0}
# Warn (Telegram) when an agent crosses this % of its window budget
WARDEN_BURN_WARN_PCT=${WARDEN_BURN_WARN_PCT:-70}
# Spike alert: tokens consumed by one channel within 5 minutes
WARDEN_BURN_SPIKE_TOKENS_5M=${WARDEN_BURN_SPIKE_TOKENS_5M:-150000}
# Retry-loop signature: N identical consecutive tool calls in the transcript
WARDEN_LOOP_REPEATS=${WARDEN_LOOP_REPEATS:-6}
# Throttle: one alert per key (agent/channel/kind) per this many seconds
WARDEN_BURN_ALERT_COOLDOWN_SECONDS=${WARDEN_BURN_ALERT_COOLDOWN_SECONDS:-3600}
# Enforcement: 0 (default) = warn-only. 1 = pause agents that exhaust their
# window budget (idle CLIs only — never an in-flight turn) and kill confirmed
# retry loops (env-matched pid, once per channel per kill cooldown).
WARDEN_BURN_ENFORCE=${WARDEN_BURN_ENFORCE:-0}
# One loop-kill per channel per this many seconds
WARDEN_BURN_KILL_COOLDOWN_SECONDS=${WARDEN_BURN_KILL_COOLDOWN_SECONDS:-3600}
# Daily Telegram digest hour (local, 0-23). Blank = no digest.
# (no-colon expansion on purpose: an intentionally blank value must survive)
WARDEN_BURN_DIGEST_HOUR=${WARDEN_BURN_DIGEST_HOUR-21}
WARDEN_BURN_DIGEST_NOTIFY=${WARDEN_BURN_DIGEST_NOTIFY:-1}

# ─── Timing ───────────────────────────────────────────────
# Cooldown: skip re-rotating the same session within this window
WARDEN_COOLDOWN_SECONDS=${WARDEN_COOLDOWN_SECONDS:-600}

# Max consecutive failures before backing off (prevents crash loop spam)
WARDEN_MAX_CONSECUTIVE_FAILURES=${WARDEN_MAX_CONSECUTIVE_FAILURES:-3}

# Minimum seconds between gateway restarts
WARDEN_GATEWAY_RESTART_COOLDOWN_SECONDS=${WARDEN_GATEWAY_RESTART_COOLDOWN_SECONDS:-300}

# Seconds of inactivity before a JSONL is considered stale (for mid-turn protection)
WARDEN_ACTIVE_THRESHOLD_SECS=${WARDEN_ACTIVE_THRESHOLD_SECS:-60}

# ─── Stall reaper ─────────────────────────────────────────
# bin/reap-stalls.sh is an independent backstop that kills wedged agent turns
# when the in-process gateway watchdog fails (e.g. the compiled-JS patch was
# wiped by `npm update`, or the gateway event loop itself is stuck). It reads
# disk + /proc only — no gateway RPC — and kills the CLI child with kill(2).
# The hard cap is generous on purpose: it only fires when the fast in-gateway
# layer didn't, so it must never touch healthy long turns (which keep writing
# their transcript). Set WARDEN_REAP_ENABLED=0 to disable.
WARDEN_REAP_ENABLED=${WARDEN_REAP_ENABLED:-1}
WARDEN_STALL_HARD_CAP_SECONDS=${WARDEN_STALL_HARD_CAP_SECONDS:-900}    # 15 min no-progress backstop
WARDEN_STALL_KILL_GRACE_SECONDS=${WARDEN_STALL_KILL_GRACE_SECONDS:-10} # SIGTERM->SIGKILL grace

# ─── Summarization ────────────────────────────────────────
# Model used for post-rotation summarization. Haiku is fast and cheap.
WARDEN_SUMMARY_MODEL=${WARDEN_SUMMARY_MODEL:-claude-haiku-4-5-20251001}

# Memory file compaction threshold (bytes). Files larger than this get compacted.
WARDEN_MEMORY_MAX_BYTES=${WARDEN_MEMORY_MAX_BYTES:-16384}

# ─── Snapshot ─────────────────────────────────────────────
# Capture standalone (non-OpenClaw) Claude Code sessions into GBrain.
# Runs via cron/timer; OpenClaw sessions are excluded (handled by context-sync).
WARDEN_SNAPSHOT_WINDOW_MINUTES=${WARDEN_SNAPSHOT_WINDOW_MINUTES:-120}     # lookback window for active sessions
WARDEN_SNAPSHOT_MIN_TURNS=${WARDEN_SNAPSHOT_MIN_TURNS:-4}                 # min new turns since last snapshot to re-summarize
WARDEN_SNAPSHOT_MAX_TURNS=${WARDEN_SNAPSHOT_MAX_TURNS:-40}                # approx cap on transcript size fed to summarizer
WARDEN_SNAPSHOT_INTERVAL_MINUTES=${WARDEN_SNAPSHOT_INTERVAL_MINUTES:-30}  # cron/timer frequency

# ─── Agent scope ──────────────────────────────────────────
# Space-separated list of agent names to scan. Empty = scan all agents.
WARDEN_SCAN_AGENTS=${WARDEN_SCAN_AGENTS:-""}

# ─── Paths ────────────────────────────────────────────────
# These are auto-detected by install.sh. Override if your layout differs.
WARDEN_OPENCLAW_HOME=${WARDEN_OPENCLAW_HOME:-$HOME/.openclaw}
WARDEN_CLAUDE_PROJECTS=${WARDEN_CLAUDE_PROJECTS:-$HOME/.claude/projects}
WARDEN_HOME=${WARDEN_HOME:-$HOME/session-warden}

# ─── Alerts (optional) ───────────────────────────────────
# Telegram bot token and chat ID for rotation alerts. Leave blank to disable.
# Put real values in ~/.config/session-warden/secrets.env (chmod 600), which is
# sourced at the end of this file. Leave these blank here.
WARDEN_TELEGRAM_BOT_TOKEN=
WARDEN_TELEGRAM_CHAT_ID=

# ─── Archive cleanup ─────────────────────────────────────
# Delete archived JSONL files older than this many days (used by cleanup-archives.sh)
WARDEN_ARCHIVE_RETENTION_DAYS=${WARDEN_ARCHIVE_RETENTION_DAYS:-7}

# ─── Logging ──────────────────────────────────────────────
WARDEN_LOG_FILE=${WARDEN_LOG_FILE:-$HOME/session-warden/state/scan.log}
WARDEN_DRY_RUN=${WARDEN_DRY_RUN:-0}

# ─── Log rotation & state cleanup (cleanup-archives.sh, daily) ──
# Rotate scan.log when it exceeds this many bytes (keeps WARDEN_LOG_KEEP rotated copies)
WARDEN_LOG_MAX_BYTES=${WARDEN_LOG_MAX_BYTES:-10485760}
WARDEN_LOG_KEEP=${WARDEN_LOG_KEEP:-3}
# Purge stale pending-recovery / pending-summary queue items after this many days
WARDEN_QUEUE_RETENTION_DAYS=${WARDEN_QUEUE_RETENTION_DAYS:-7}
# Purge cooldown failure counters untouched for this many days (resets stale backoff)
WARDEN_COOLDOWN_RETENTION_DAYS=${WARDEN_COOLDOWN_RETENTION_DAYS:-7}

# ─── Doctor (self-health, doctor.sh) ─────────────────────
# Max age in seconds for scan/reap heartbeats before doctor reports the loop dead
WARDEN_DOCTOR_MAX_SCAN_AGE=${WARDEN_DOCTOR_MAX_SCAN_AGE:-240}
WARDEN_DOCTOR_MAX_REAP_AGE=${WARDEN_DOCTOR_MAX_REAP_AGE:-240}
# Throttle Telegram doctor alerts to one per this many seconds
WARDEN_DOCTOR_ALERT_COOLDOWN_SECONDS=${WARDEN_DOCTOR_ALERT_COOLDOWN_SECONDS:-3600}
# Set to 1 to verify the contrib OpenClaw dist patches are applied (host-specific)
WARDEN_DOCTOR_CHECK_PATCHES=${WARDEN_DOCTOR_CHECK_PATCHES:-0}
# Dead-man's switch: URL pinged on every fully-healthy doctor run (e.g. healthchecks.io).
# If pings stop, the external service alerts you — covers warden-host death.
WARDEN_HEARTBEAT_URL=${WARDEN_HEARTBEAT_URL:-""}

# ─── Recovery delivery invariants (scan.sh drainer) ──────
# A recovery prompt is only valuable fresh and once. Items older than the TTL
# are dropped at delivery time (a stalled queue degrades to a quiet no-op, not
# a delayed prompt storm); channels recovered within the dedup window are
# skipped (no double-prompting).
WARDEN_RECOVERY_TTL_SECONDS=${WARDEN_RECOVERY_TTL_SECONDS:-1800}
WARDEN_RECOVERY_DEDUP_SECONDS=${WARDEN_RECOVERY_DEDUP_SECONDS:-1800}

# ─── Zombie detection scope ──────────────────────────────
# A session only counts as a zombie if its channel had activity within this
# window (updatedAt). Idle sessions with a dead CLI process are the normal
# resting state of a finished conversation — rotating them creates a
# fleet-wide rotate->recover->idle->rotate loop.
WARDEN_ZOMBIE_ACTIVE_WINDOW_SECONDS=${WARDEN_ZOMBIE_ACTIVE_WINDOW_SECONDS:-7200}

# Reflector: nightly lesson distillation (bin/reflect.sh, deploy/reflect.timer)
# Distills 0-5 general lessons per agent from the last 24h of material, runs a
# skeptical verifier pass, and stages survivors in the agent's
# memory/pending-lessons-YYYY-MM-DD.md for human review (bin/apply-lessons.sh).
WARDEN_REFLECT_AGENTS=${WARDEN_REFLECT_AGENTS:-"ping bloop dash isaac zara kai nova remy"}  # space-separated agents to reflect on — replace with your own agent names
WARDEN_REFLECT_MODEL=${WARDEN_REFLECT_MODEL:-claude-sonnet-4-6}                    # distillation model (stronger than the summary model on purpose)
WARDEN_REFLECT_VERIFY_MODEL=${WARDEN_REFLECT_VERIFY_MODEL:-claude-haiku-4-5-20251001}  # skeptic/verifier model (cheap)
WARDEN_REFLECT_AUTO_APPLY=${WARDEN_REFLECT_AUTO_APPLY:-0}   # 1 = append verified lessons straight into MEMORY.md (skips human review — not recommended)
WARDEN_REFLECT_NOTIFY=${WARDEN_REFLECT_NOTIFY:-1}           # 1 = one Telegram digest per run with per-agent lesson counts
WARDEN_REFLECT_WINDOW_MINUTES=${WARDEN_REFLECT_WINDOW_MINUTES:-1440}  # lookback window for material (default 24h)

# Skill harvester: weekly per-agent skill mining (bin/harvest-skills.sh, deploy/harvest.timer)
# Mines the week's material (rotation summaries, daily notes, applied lessons)
# for workflows an agent performed 2+ times that no existing skill covers, and
# stages SKILL.md drafts in ~/.openclaw/skills-pending/<agent>/<skill>/ for
# review (promote with bin/promote-skill.sh <agent> <skill> [--shared]).
WARDEN_HARVEST_AGENTS=${WARDEN_HARVEST_AGENTS:-"ping bloop dash isaac zara kai nova remy"}  # space-separated agents to harvest — replace with your own agent names
WARDEN_HARVEST_WINDOW_DAYS=${WARDEN_HARVEST_WINDOW_DAYS:-7}      # lookback window for material (default one week)
WARDEN_HARVEST_MODEL=${WARDEN_HARVEST_MODEL:-claude-sonnet-4-6}  # skill-mining model (needs to see structure across a week)
WARDEN_HARVEST_NOTIFY=${WARDEN_HARVEST_NOTIFY:-1}                # 1 = one Telegram digest per run with per-agent proposal counts

# Model scorecard: weekly Hermes A/B benchmark (bin/scorecard.sh, deploy/scorecard.timer)
# Runs the fixed task set in config/scorecard-tasks.jsonl through each
# experimental Hermes agent (~/.hermes-<name>) as a real non-interactive turn,
# scores each answer 0-10 with a BLIND judge (never told which agent/model
# answered), and writes state/scorecard/<date>/REPORT.md + GBrain + Telegram.
WARDEN_SCORECARD_AGENTS=${WARDEN_SCORECARD_AGENTS:-"carolyn midi baymax"}       # experimental Hermes agents, one home each at ~/.hermes-<name> — replace with your own
WARDEN_SCORECARD_JUDGE_MODEL=${WARDEN_SCORECARD_JUDGE_MODEL:-claude-sonnet-4-6} # blind judge — scores answers against each task's rubric
WARDEN_SCORECARD_TURN_TIMEOUT=${WARDEN_SCORECARD_TURN_TIMEOUT:-180}             # seconds per agent turn before it's scored 0
WARDEN_SCORECARD_NOTIFY=${WARDEN_SCORECARD_NOTIFY:-1}                           # 1 = one Telegram digest per run with the totals table
WARDEN_HERMES_BIN=${WARDEN_HERMES_BIN:-$HOME/hermes-agent/venv/bin/hermes}      # Hermes v0.18 CLI (shared venv, per-agent via HERMES_HOME)

# Memory evals: monthly memory-quality regression (bin/eval-memory.sh, deploy/eval-memory.timer)
# Replays fixed eval cases (~/.openclaw/evals/<agent>/cases.jsonl, produced
# once with --generate <agent>) against each agent's CURRENT MEMORY.md +
# AGENTS.md; the pass-rate delta vs the previous run is the regression signal.
WARDEN_EVAL_AGENTS=${WARDEN_EVAL_AGENTS:-"ping bloop dash isaac zara kai nova remy"}  # space-separated OpenClaw agents under eval — replace with your own agent names
WARDEN_EVAL_MODEL=${WARDEN_EVAL_MODEL:-claude-sonnet-4-6}                       # answers each case with the agent's memory attached (simulated turn)
WARDEN_EVAL_JUDGE_MODEL=${WARDEN_EVAL_JUDGE_MODEL:-claude-haiku-4-5-20251001}   # PASS/FAIL judge (cheap)
WARDEN_EVAL_GEN_MODEL=${WARDEN_EVAL_GEN_MODEL:-claude-sonnet-4-6}               # --generate case writer (needs to read the whole memory)
WARDEN_EVAL_NOTIFY=${WARDEN_EVAL_NOTIFY:-1}                                     # 1 = one Telegram digest per run with pass rates + deltas

# ─── Advanced knobs (defaults shown; uncomment to override) ──
# Every variable the scripts read is listed here for completeness.
#
# Post a chat alert on every routine threshold rotation. Off by default —
# routine rotations recover silently (logged only); crash and stall
# recoveries always notify regardless.
#WARDEN_NOTIFY_ROTATIONS=0
# Restart the gateway after a rotation batch even when not strictly required
#WARDEN_RESTART_GATEWAY_AFTER_ROTATION=0
# Seconds rotate.sh waits for a graceful CLI shutdown before escalating
#WARDEN_GRACEFUL_TIMEOUT=20
# Seconds before any single gbrain CLI call is abandoned (never blocks rotation)
#WARDEN_GBRAIN_TIMEOUT=25
# Seconds a crash buffer stays deliverable before it's considered stale
#WARDEN_CRASH_BUFFER_TTL=7200
# Doctor: warn when a state/ log exceeds this many bytes
#WARDEN_DOCTOR_LOG_WARN_BYTES=52428800
# Doctor: skip gateway + channel-parity checks (for hosts without a gateway)
#WARDEN_DOCTOR_SKIP_GATEWAY=0
# Doctor: worktree GC warnings — live worktree count / total size (MB)
#WARDEN_DOCTOR_WT_COUNT_WARN=20
#WARDEN_DOCTOR_WT_SIZE_WARN_MB=2048
# Doctor: OpenClaw dist dir for the opt-in patch checks (WARDEN_DOCTOR_CHECK_PATCHES=1)
#WARDEN_OPENCLAW_DIST=$HOME/.npm-global/lib/node_modules/openclaw/dist
# Doctor: path to the channel-parity helper
#WARDEN_PARITY_SH=$WARDEN_HOME/contrib/openclaw-patches/channel-parity.sh
# Scorecard: alternative task set (JSONL of {id, category, prompt, rubric})
#WARDEN_SCORECARD_TASKS=$WARDEN_HOME/config/scorecard-tasks.jsonl
# Worktree GC (reap-worktrees.sh) log file
#WARDEN_WT_LOG_FILE=$WARDEN_HOME/state/worktree-gc.log
# Agent attribution: alternative path-glob → agent map (see agent-paths.env.example)
#WARDEN_AGENT_PATH_MAP=$WARDEN_HOME/config/agent-paths.env
#
# Test seams (used by the test suite, not user config): WARDEN_CRONTAB_CMD
# (mock crontab binary), WARDEN_PROC (mock /proc root).

# Load secrets (Telegram token/chat ID) from outside the repo tree
[ -f "$HOME/.config/session-warden/secrets.env" ] && . "$HOME/.config/session-warden/secrets.env"

# Recovery announcements: 0 (default) = all recoveries re-orient silently;
# 1 = crash/stall recoveries post an "I am back" message to the channel.
WARDEN_ANNOUNCE_RECOVERIES=${WARDEN_ANNOUNCE_RECOVERIES:-0}
