# agent-paths.env — optional agent attribution for standalone Claude Code
# sessions (the ones snapshot.sh ingests from ~/.claude/projects).
#
# OpenClaw agents are already resolved by their ~/.openclaw/agents/<name>
# directory, so you only need this if you ALSO run plain Claude Code in your own
# repos and want those sessions attributed to a named agent instead of "unknown".
#
# Format:  <glob pattern>  =  <agent name>
#   - the pattern is matched against the session's working directory with shell
#     globbing (so wrap loosely in *...*)
#   - first match wins, so list the most specific patterns first
#   - lines starting with # and blank lines are ignored
#
# Copy this file to config/agent-paths.env (gitignored) and edit. Examples:
#
#   *myorg*frontend*   = web-team
#   *myorg*            = backend
#   */work/scraper*    = scraper-bot
