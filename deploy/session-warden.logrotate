# session-warden logrotate policy — install to /etc/logrotate.d/session-warden:
#   sed "s/YOUR_USER/$(whoami)/g" deploy/session-warden.logrotate \
#     | sudo tee /etc/logrotate.d/session-warden >/dev/null
#
# Covers every log the warden writes (scan.log, reflect.log, harvest.log, ...).
# Replace YOUR_USER below (or use the sed one-liner above), and adjust the
# path if the repo doesn't live at ~/session-warden.
#
# Notes:
#   - copytruncate: writers append via `>>` with no reopen signal, so truncate
#     in place instead of moving the file out from under them.
#   - dateext: keeps names disjoint from cleanup-archives.sh's size-based
#     emergency rotation (scan.log.1, .2, ...), which stays as the between-runs
#     backstop for sudden log floods.
#   - su: state/ is user-owned; without this logrotate (running as root)
#     refuses to rotate inside a non-root-owned parent directory.

/home/YOUR_USER/session-warden/state/*.log {
    weekly
    rotate 4
    compress
    delaycompress
    dateext
    missingok
    notifempty
    copytruncate
    su YOUR_USER YOUR_USER
}
