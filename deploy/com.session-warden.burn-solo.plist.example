<?xml version="1.0" encoding="UTF-8"?>
<!--
session-warden burn-solo launchd user agent

Install:
  mkdir -p ~/Library/LaunchAgents
  sed "s#__WARDEN_HOME__#$HOME/session-warden#g" \
    deploy/com.session-warden.burn-solo.plist.example \
    > ~/Library/LaunchAgents/com.session-warden.burn-solo.plist
  launchctl load ~/Library/LaunchAgents/com.session-warden.burn-solo.plist

This is intentionally not installed by install.sh; enable it only on Macs
where you want standalone Claude Code sessions metered into the burn ledger.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.session-warden.burn-solo</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WARDEN_HOME__/bin/burn-solo-sample.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>WARDEN_HOME</key>
    <string>__WARDEN_HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__WARDEN_HOME__/state/burn-solo.launchd.log</string>

  <key>StandardErrorPath</key>
  <string>__WARDEN_HOME__/state/burn-solo.launchd.err</string>
</dict>
</plist>
